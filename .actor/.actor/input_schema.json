{
  "title": "Site Memory Agent",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "action": {
      "title": "Action",
      "type": "string",
      "description": "REQUIRED. Operation to perform: remember | recall | search | forget | context_pack",
      "enum": ["remember", "recall", "search", "forget", "context_pack"],
      "default": "context_pack",
      "prefill": "context_pack"
    },
    "memoryStoreId": {
      "title": "Memory store ID",
      "type": "string",
      "description": "REQUIRED. Stable id for your named key-value store (e.g. my-github-user~stripe-integration). Same id across sessions = persistent memory.",
      "editor": "textfield",
      "pattern": "^[a-z0-9_\\-~.]{3,100}$",
      "prefill": "demo-user~apify-mcp-project"
    },
    "url": {
      "title": "URL",
      "type": "string",
      "description": "Page URL for remember, recall, or context_pack. Normalized for matching.",
      "editor": "textfield",
      "format": "uri",
      "prefill": "https://docs.apify.com/integrations/mcp",
      "maxLength": 2000
    },
    "content": {
      "title": "Memory content",
      "type": "string",
      "description": "Text to save when action is remember.",
      "editor": "textarea",
      "maxLength": 200000
    },
    "query": {
      "title": "Search query",
      "type": "string",
      "description": "Keywords for search or to rank context_pack results.",
      "editor": "textfield",
      "maxLength": 1000
    },
    "memoryId": {
      "title": "Memory ID",
      "type": "string",
      "description": "UUID of a single memory (forget, or remember update if provided).",
      "editor": "textfield",
      "format": "uuid"
    },
    "projectId": {
      "title": "Project ID",
      "type": "string",
      "description": "Optional filter (repo name, feature slug).",
      "editor": "textfield",
      "maxLength": 200
    },
    "maxResults": {
      "title": "Max results",
      "type": "integer",
      "description": "Limit for recall and search.",
      "default": 20,
      "minimum": 1,
      "maximum": 500
    },
    "maxTokens": {
      "title": "Max tokens (estimate)",
      "type": "integer",
      "description": "Approximate token budget for context_pack markdown.",
      "default": 2500,
      "minimum": 200,
      "maximum": 8000
    },
    "idempotencyKey": {
      "title": "Idempotency key",
      "type": "string",
      "description": "Optional client-provided idempotency key to deduplicate repeated remember/create requests.",
      "editor": "textfield",
      "maxLength": 100
    },
    "memoryDetails": {
      "title": "Memory details",
      "type": "object",
      "description": "Optional structured metadata when remembering.",
      "editor": "json",
      "properties": {
        "title": { "title": "Memory title", "type": "string", "description": "Short descriptive title for this memory.", "maxLength": 300 },
        "memoryType": {
          "title": "Memory type",
          "type": "string",
          "enum": [
            "integration_note",
            "api_quirk",
            "auth_flow",
            "selector",
            "breaking_change",
            "project_binding",
            "general"
          ]
        },
        "tags": {
          "title": "Tags",
          "type": "array",
          "items": { "type": "string", "maxLength": 50 },
          "maxItems": 50,
          "description": "Optional tags to help categorize this memory."
        },
        "confidence": {
          "title": "Confidence",
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Estimated confidence (0.0 - 1.0) in the memory's accuracy."
        },
        "source": {
          "title": "Source",
          "type": "string",
          "enum": ["agent", "human", "crawl"]
        },
        "relatedUrls": {
          "title": "Related URLs",
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        }
      }
    }
  },
  "required": ["action", "memoryStoreId"],
  "examples": [
    {
      "action": "remember",
      "memoryStoreId": "demo-user~apify-mcp",
      "url": "https://docs.example.com/integration",
      "content": "Note: This API uses a nonstandard rate-limit header 'X-Rate-Limit-Limit'.",
      "memoryDetails": { "title": "Rate-limit header quirk", "memoryType": "api_quirk", "tags": ["rate-limit", "header"] }
    },
    {
      "action": "context_pack",
      "memoryStoreId": "demo-user~apify-mcp",
      "query": "authentication",
      "maxTokens": 2000
    }
  ],
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "remember" } } },
      "then": { "required": ["content"] }
    },
    {
      "if": { "properties": { "action": { "const": "forget" } } },
      "then": { "required": ["memoryId"] }
    },
    {
      "if": { "properties": { "action": { "const": "recall" } } },
      "then": { "required": ["url"] }
    },
    {
      "if": { "properties": { "action": { "const": "search" } } },
      "then": { "required": ["query"] }
    }
  ]
}
