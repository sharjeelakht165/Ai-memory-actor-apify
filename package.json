{
  "name": "site-memory-agent",
  "version": "0.1.0",
  "type": "module",
  "description": "Persistent website memory for AI coding agents (MCP via Apify)",
  "scripts": {
    "start": "node src/main.js",
    "start:server": "ACTOR_MODE=server tsx src/server.ts",
    "start:mcp": "ACTOR_MODE=mcp tsx src/mcp-server.ts",
    "test": "node --test test/*.test.js",
    "test:local": "node scripts/local-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "apify": "^3.5.2",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
